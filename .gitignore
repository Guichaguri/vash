/target
**/*.rs.bk

# Local database directories
/data
*.mdb
*.mdb-lock

# IDE
/.idea
/.vscode

# Local overrides
/vash.local.toml

# Fuzzing. `fuzz/seeds` is committed — it is generated from the encoders by
# `cargo run -p vash-proto --example seed_corpus` and is what the targets start
# from. `corpus` is what libFuzzer grows from those at runtime, and `artifacts`
# is where it drops a crashing input; neither belongs in the repository.
/fuzz/target
/fuzz/corpus
/fuzz/artifacts
